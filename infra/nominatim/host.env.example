# Persistent Nominatim database. Keep it outside the repository because the
# initial import creates a PostgreSQL data directory here.
NOMINATIM_DB_DIR=/home/ryan/services/atlas-nominatim/postgres

# Nominatim owns this import directory. The preflight copies and checks the
# verified Austin.osm.pbf from Valhalla before starting the container.
NOMINATIM_OSM_DIR=/home/ryan/services/atlas-nominatim/osm

NOMINATIM_PLATFORM=linux/amd64
NOMINATIM_PORT=8082

# Conservative limits for the 8 GiB host while Valhalla remains available.
NOMINATIM_THREADS=2
NOMINATIM_GUNICORN_WORKERS=2
NOMINATIM_POSTGRES_SHARED_BUFFERS=1GB
NOMINATIM_POSTGRES_MAINTENANCE_WORK_MEM=1GB
NOMINATIM_POSTGRES_AUTOVACUUM_WORK_MEM=256MB
NOMINATIM_POSTGRES_WORK_MEM=16MB
NOMINATIM_POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
NOMINATIM_POSTGRES_MAX_WAL_SIZE=1GB
NOMINATIM_POSTGRES_MAX_CONNECTIONS=20

# A locally generated PostgreSQL password. Never commit its real value.
NOMINATIM_PASSWORD=replace-with-a-long-random-password
