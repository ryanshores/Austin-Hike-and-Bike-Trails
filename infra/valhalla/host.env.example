# Persistent host directory. Keep graph artifacts outside the repository.
VALHALLA_DATA_DIR=/srv/atlas-valhalla/custom_files

# ryan-mini is x86_64. The pinned image is a multi-architecture manifest, and
# this prevents Docker from selecting a different platform unexpectedly.
VALHALLA_PLATFORM=linux/amd64

# Two threads is conservative for ryan-mini's 8 GiB RAM. Increase only after a
# successful build while watching memory pressure.
VALHALLA_SERVER_THREADS=2

# Cloudflare's remotely managed Tunnel token. Never commit the real value.
TUNNEL_TOKEN=replace-with-dashboard-generated-token
