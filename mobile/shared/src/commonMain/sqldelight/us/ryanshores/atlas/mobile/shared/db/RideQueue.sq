PRAGMA foreign_keys = 1;

CREATE TABLE active_ride (
  singleton INTEGER NOT NULL PRIMARY KEY CHECK (singleton = 1),
  ride_id TEXT NOT NULL UNIQUE,
  owner_id TEXT NOT NULL,
  started_at INTEGER NOT NULL CHECK (started_at >= 0),
  status TEXT NOT NULL CHECK (status IN ('recording', 'stopping')),
  next_sequence INTEGER NOT NULL DEFAULT 0 CHECK (next_sequence >= 0),
  last_recorded_at INTEGER CHECK (last_recorded_at IS NULL OR last_recorded_at >= 0),
  last_latitude REAL CHECK (last_latitude IS NULL OR (last_latitude >= -90 AND last_latitude <= 90)),
  last_longitude REAL CHECK (last_longitude IS NULL OR (last_longitude >= -180 AND last_longitude <= 180)),
  last_accuracy_meters REAL CHECK (last_accuracy_meters IS NULL OR (last_accuracy_meters >= 0 AND last_accuracy_meters <= 100)),
  CHECK (
    (last_recorded_at IS NULL AND last_latitude IS NULL AND last_longitude IS NULL AND last_accuracy_meters IS NULL)
    OR
    (last_recorded_at IS NOT NULL AND last_latitude IS NOT NULL AND last_longitude IS NOT NULL AND last_accuracy_meters IS NOT NULL)
  )
);

CREATE TABLE queued_ride_point (
  ride_id TEXT NOT NULL REFERENCES active_ride(ride_id) ON DELETE CASCADE,
  sequence INTEGER NOT NULL CHECK (sequence >= 0),
  batch_id TEXT,
  recorded_at INTEGER NOT NULL CHECK (recorded_at >= 0),
  latitude REAL NOT NULL CHECK (latitude >= -90 AND latitude <= 90),
  longitude REAL NOT NULL CHECK (longitude >= -180 AND longitude <= 180),
  accuracy_meters REAL NOT NULL CHECK (accuracy_meters >= 0 AND accuracy_meters <= 100),
  altitude_meters REAL,
  speed_meters_per_second REAL CHECK (speed_meters_per_second IS NULL OR speed_meters_per_second >= 0),
  heading_degrees REAL CHECK (heading_degrees IS NULL OR (heading_degrees >= 0 AND heading_degrees < 360)),
  quality TEXT NOT NULL CHECK (quality IN ('good', 'fair', 'poor')),
  PRIMARY KEY (ride_id, sequence)
);

CREATE INDEX queued_ride_point_batch
ON queued_ride_point(ride_id, batch_id, sequence);

selectActiveRide:
SELECT ride_id, owner_id, started_at, status, next_sequence, last_recorded_at,
       last_latitude, last_longitude, last_accuracy_meters
FROM active_ride
WHERE singleton = 1;

insertActiveRide:
INSERT INTO active_ride(
  singleton, ride_id, owner_id, started_at, status, next_sequence,
  last_recorded_at, last_latitude, last_longitude, last_accuracy_meters
)
VALUES (1, :rideId, :ownerId, :startedAt, 'recording', 0, NULL, NULL, NULL, NULL);

insertPointAtNextSequence:
INSERT INTO queued_ride_point(
  ride_id,
  sequence,
  batch_id,
  recorded_at,
  latitude,
  longitude,
  accuracy_meters,
  altitude_meters,
  speed_meters_per_second,
  heading_degrees,
  quality
)
SELECT
  ride_id,
  next_sequence,
  NULL,
  :recordedAt,
  :latitude,
  :longitude,
  :accuracyMeters,
  :altitudeMeters,
  :speedMetersPerSecond,
  :headingDegrees,
  :quality
FROM active_ride
WHERE singleton = 1 AND status = 'recording';

advanceSequence:
UPDATE active_ride
SET next_sequence = next_sequence + 1,
    last_recorded_at = :recordedAt,
    last_latitude = :latitude,
    last_longitude = :longitude,
    last_accuracy_meters = :accuracyMeters
WHERE singleton = 1 AND status = 'recording';

selectQueuedPoints:
SELECT
  ride_id,
  sequence,
  batch_id,
  recorded_at,
  latitude,
  longitude,
  accuracy_meters,
  altitude_meters,
  speed_meters_per_second,
  heading_degrees,
  quality
FROM queued_ride_point
WHERE ride_id = :rideId
ORDER BY sequence ASC;

selectFirstQueuedPoint:
SELECT ride_id, sequence, batch_id, recorded_at
FROM queued_ride_point
WHERE ride_id = :rideId
ORDER BY sequence ASC
LIMIT 1;

assignNextBatch:
UPDATE queued_ride_point
SET batch_id = :batchId
WHERE ride_id = :rideId
  AND batch_id IS NULL
  AND sequence IN (
    SELECT sequence
    FROM queued_ride_point
    WHERE ride_id = :rideId AND batch_id IS NULL
    ORDER BY sequence ASC
    LIMIT :maximumPoints
  );

selectBatch:
SELECT
  ride_id,
  sequence,
  batch_id,
  recorded_at,
  latitude,
  longitude,
  accuracy_meters,
  altitude_meters,
  speed_meters_per_second,
  heading_degrees,
  quality
FROM queued_ride_point
WHERE ride_id = :rideId AND batch_id = :batchId
ORDER BY sequence ASC;

deleteBatch:
DELETE FROM queued_ride_point
WHERE ride_id = :rideId AND batch_id = :batchId;

deletePointsForRide:
DELETE FROM queued_ride_point
WHERE ride_id = :rideId;

markStopping:
UPDATE active_ride
SET status = 'stopping'
WHERE singleton = 1 AND ride_id = :rideId;

deleteCompletedRideIfEmpty:
DELETE FROM active_ride
WHERE singleton = 1
  AND ride_id = :rideId
  AND status = 'stopping'
  AND NOT EXISTS (
    SELECT 1 FROM queued_ride_point WHERE queued_ride_point.ride_id = active_ride.ride_id
  );

deleteActiveRide:
DELETE FROM active_ride
WHERE singleton = 1 AND ride_id = :rideId;
